{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/images/najiya-pm.jpg",
      "destination": "/images/najiya-p-m-speech-language-pathologist.jpg",
      "permanent": true
    },
    {
      "source": "/images/najiya-pm-2.jpg",
      "destination": "/images/najiya-p-m-speech-language-pathologist.jpg",
      "permanent": true
    },
    {
      "source": "/online-speech-therapy-thrissur",
      "destination": "/online-speech-therapy-kerala",
      "permanent": true
    },
    {
      "source": "/online-speech-therapy-for-malayali-families-abroad",
      "destination": "/online-speech-therapy-uae",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-32x32.png|favicon.png|apple-touch-icon.png|android-chrome-192x192.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
